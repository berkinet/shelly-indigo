<?xml version="1.0"?>
<MenuItems>
  <MenuItem id="createDiscoveredDevices">
    <Name>Create Indigo Devices…</Name>
    <CallbackMethod>createDiscoveredDevices</CallbackMethod>
    <ButtonTitle>Create Devices</ButtonTitle>
    <ConfigUI>
      <Field id="shellyId" type="menu" defaultValue="_all_">
        <Label>Shelly device:</Label>
        <List class="self" method="getDiscoveredShellyDevices" dynamicReload="true" />
      </Field>
      <Field id="refreshDiscoveredDevices" type="button">
        <Label />
        <Title>Refresh discovered devices</Title>
        <CallbackMethod>refreshDiscoveredDevices</CallbackMethod>
      </Field>
      <Field id="includeSwitches" type="checkbox" defaultValue="true">
        <Label>Switches:</Label>
        <Description>Create missing relay/switch devices</Description>
      </Field>
      <Field id="includeDimmers" type="checkbox" defaultValue="true">
        <Label>Dimmers:</Label>
        <Description>Create missing dimmable light output devices</Description>
      </Field>
      <Field id="includeInputs" type="checkbox" defaultValue="false">
        <Label>Inputs:</Label>
        <Description>Create missing binary/button input devices</Description>
      </Field>
      <Field id="creationHelp" type="label">
        <Label>Creates only the selected channel types for currently connected discovered devices. Existing devices and names are preserved. Devices marked no supported channels are discovered but cannot yet be created. Discovery continues without creating devices automatically.</Label>
      </Field>
    </ConfigUI>
  </MenuItem>
  <MenuItem id="setDevicePassword">
    <Name>Set Device Password…</Name>
    <CallbackMethod>setDevicePassword</CallbackMethod>
    <ButtonTitle>Save Password</ButtonTitle>
    <ConfigUI>
      <Field id="shellyId" type="menu" defaultValue="_none_">
        <Label>Shelly device:</Label>
        <List class="self" method="getCredentialDevices" dynamicReload="true" />
      </Field>
      <Field id="refreshCredentialDevices" type="button">
        <Label />
        <Title>Refresh discovered devices</Title>
        <CallbackMethod>refreshDiscoveredDevices</CallbackMethod>
      </Field>
      <Field id="devicePassword" type="textfield" secure="true" defaultValue="">
        <Label>Local device password:</Label>
      </Field>
      <Field id="credentialHelp" type="label">
        <Label>Sets the local admin password used for this physical Shelly and all its channels. This does not change the password on the Shelly. Blank explicitly selects no password. Stored passwords are masked in this dialog and kept in Indigo preferences. A new discovered device never receives the shared password automatically.</Label>
      </Field>
    </ConfigUI>
  </MenuItem>
</MenuItems>
