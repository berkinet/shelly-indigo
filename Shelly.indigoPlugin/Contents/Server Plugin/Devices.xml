<?xml version='1.0' encoding='utf-8'?>
<Devices>
  <Device id="shellySwitch" type="relay">
    <Name>Shelly Switch</Name>
    <ConfigUI>
      <Field id="selectedChannel" type="menu" defaultValue="_none_">
        <Label>Shelly channel:</Label>
        <List class="self" method="getShellyChannels" dynamicReload="true" />
        <CallbackMethod>shellyChannelSelected</CallbackMethod>
      </Field>
      <Field id="refreshChannels" type="button">
        <Label />
        <Title>Refresh discovered channels</Title>
        <CallbackMethod>refreshShellyChannels</CallbackMethod>
      </Field>
      <Field id="channelHelp" type="label">
        <Label>Shows unassigned channels and this device’s current channel. Edit an existing Indigo device to change its assigned channel.</Label>
      </Field>
      <Field id="devicePassword" type="textfield" secure="true" defaultValue="">
        <Label>Local device password:</Label>
      </Field>
      <Field id="clearDevicePassword" type="checkbox" defaultValue="false">
        <Label>No password:</Label>
        <Description>Remove the saved password for this physical Shelly</Description>
      </Field>
      <Field id="passwordHelp" type="label">
        <Label>Leave the password blank to keep the saved credential. A change applies to all channels on this physical Shelly. This is its local admin password, not your cloud login; it does not change the password on the Shelly.</Label>
      </Field>
      <Field id="credentialEditToken" type="textfield" hidden="true" defaultValue="" />
      <Field id="shellyId" type="textfield" readonly="true">
        <Label>Shelly ID:</Label>
      </Field>
      <Field id="component" type="textfield" readonly="true">
        <Label>Channel:</Label>
      </Field>
      <Field id="host" type="textfield" readonly="true">
        <Label>Host:</Label>
      </Field>
      <Field id="model" type="textfield" readonly="true">
        <Label>Model:</Label>
      </Field>
      <Field id="generation" type="textfield" readonly="true">
        <Label>Generation:</Label>
      </Field>
      <Field id="address" type="textfield" hidden="true">
        <Label>Address:</Label>
      </Field>
    </ConfigUI>
    <States>
      <State id="online">
        <ValueType>Boolean</ValueType>
        <TriggerLabel>Online</TriggerLabel>
        <ControlPageLabel>Online</ControlPageLabel>
      </State>
      <State id="powerWatts">
        <ValueType>Number</ValueType>
        <TriggerLabel>Power (W)</TriggerLabel>
        <ControlPageLabel>Power (W)</ControlPageLabel>
      </State>
      <State id="voltage">
        <ValueType>Number</ValueType>
        <TriggerLabel>Voltage (V)</TriggerLabel>
        <ControlPageLabel>Voltage (V)</ControlPageLabel>
      </State>
      <State id="currentAmps">
        <ValueType>Number</ValueType>
        <TriggerLabel>Current (A)</TriggerLabel>
        <ControlPageLabel>Current (A)</ControlPageLabel>
      </State>
      <State id="energyWh">
        <ValueType>Number</ValueType>
        <TriggerLabel>Energy (Wh)</TriggerLabel>
        <ControlPageLabel>Energy (Wh)</ControlPageLabel>
      </State>
    </States>
  </Device>
